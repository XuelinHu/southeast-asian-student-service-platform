\set ON_ERROR_STOP on
\set default_database 'international_student_platform'
\set app_role 'international_student_platform_app'
\prompt 'Project database name [international_student_platform]: ' requested_database
SELECT COALESCE(NULLIF(:'requested_database', ''), :'default_database') AS app_database \gset
SELECT CASE WHEN :'app_database' ~ '^[a-z][a-z0-9_]{0,62}$' THEN 1 ELSE 1 / 0 END;

SELECT format($sql$DO $body$ BEGIN
  IF EXISTS (SELECT 1 FROM pg_database WHERE datname = %L
    AND pg_get_userbyid(datdba) IS DISTINCT FROM %L) THEN
    RAISE EXCEPTION 'Database exists with a different owner; inspect and migrate it explicitly';
  END IF;
END $body$;$sql$, :'app_database', :'app_role')\gexec

SELECT CASE
  WHEN EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'app_role')
    THEN format('ALTER ROLE %I WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT', :'app_role')
  ELSE format('CREATE ROLE %I WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT', :'app_role')
END
\gexec

\password international_student_platform_app

SELECT format('CREATE DATABASE %I OWNER %I ENCODING %L', :'app_database', :'app_role', 'UTF8')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'app_database')
\gexec

SELECT format('REVOKE ALL ON DATABASE %I FROM PUBLIC', :'app_database')
\gexec
SELECT format('GRANT CONNECT, TEMPORARY ON DATABASE %I TO %I', :'app_database', :'app_role')
\gexec
