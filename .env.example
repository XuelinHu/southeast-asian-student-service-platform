PORT=8034
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-a-local-secret
DB_NAME=international_student_platform
JWT_SECRET=change_this_secret_before_production
JWT_EXPIRES_IN=8h

# 仅隔离开发/测试库可手动启用演示数据；生产环境 seed 会被拒绝。
ALLOW_DEMO_SEED=0
DEMO_SEED_DATABASE=international_student_platform_dev
DEMO_SEED_PASSWORD=Replace-With-Random-Secret-2026!

# ---------------------------------------------------------------------------
# 智能体 / 大模型
# ---------------------------------------------------------------------------

# 本地 Ollama 地址。只允许回环地址：该端口不应暴露到公网（Ollama 自身没有鉴权）。
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 环境变量声明的本地模型，逗号分隔。会与 Ollama /api/tags 实时扫描到的模型合并后
# 一起出现在前端下拉里。声明了但本机未下载的模型会标记为 unavailable 而不是隐藏，
# 方便看出"该拉哪个模型"。
LOCAL_LLM_MODELS=qwen2.5:0.5b,qwen3:14b

# 默认选中的模型，格式 <provider>:<model>。
# 测试/联调用最小的 qwen2.5:0.5b（0.4GB，冷启动几秒，工具调用链路完整）；
# 演示时改成 ollama:qwen3:14b 拿回答质量，不需要改代码。
LLM_DEFAULT_MODEL=ollama:qwen2.5:0.5b

# Ollama 模型仓库目录。用于扫描本机已下载的模型 —— 即使 Ollama 服务没起来，
# 下拉里也能列出磁盘上真实存在的模型。读不到只会降级（少一份兜底来源），不影响启动。
OLLAMA_MODELS_DIR=/usr/share/ollama/.ollama/models

# 单卡显存上限（GB）。超过这个体积的模型在下拉里置灰并写明原因，服务端也会拒绝加载，
# 避免绕过前端硬选一个装不下的模型把显存打爆。
LLM_MAX_MODEL_SIZE_GB=24

# 只列本地模型。默认 true：这套系统面向内网/离线场景。设为 false 时，
# 配了 key 的云端模型（DEEPSEEK_API_KEY / BAILIAN_API_KEY）会重新出现在下拉里。
LLM_LOCAL_ONLY=true

# 模型在显存中的保活时间。过长会一直占着显存，过短会导致每次都冷启动（实测冷启动
# 首次调用约 55s，热模型约 5s）。
LLM_KEEP_ALIVE=30m

# 同时进行的推理请求上限。本机 3090 显存紧张，默认串行。
LLM_MAX_CONCURRENCY=1

# 单轮与整体超时（毫秒）。14B 冷启动 + 长上下文时首字较慢，不要调太小。
LLM_REQUEST_TIMEOUT_MS=180000

# 云端兜底。留空则对应的云端模型不会出现在下拉里（不会报错）。
# 也可以只配在 shell 的 ~/.zshrc 里，进程环境变量优先于本文件。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner

BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODELS=qwen-plus,qwen-turbo

# 智能体行为
AGENT_MAX_TOOL_ROUNDS=4
# 是否把模型思考过程透传给前端（qwen3 等支持 thinking 的模型）。前端展示为可折叠区域。
AGENT_THINKING=true
# 是否允许未登录游客使用知识问答（不挂载任何查库工具）
AGENT_GUEST_ENABLED=true
WEB_PORT=4034
